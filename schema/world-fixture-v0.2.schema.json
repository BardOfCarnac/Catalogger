{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vend-r.invalid/schema/world-fixture-v0.2.schema.json",
  "title": "Vend-R source-defined world fixture v0.2",
  "type": "object",
  "required": ["format_version", "world_id", "fixture_id", "fixture_status", "entities"],
  "properties": {
    "format_version": {"const": "0.2.0"},
    "world_id": {"type": "string", "minLength": 1},
    "fixture_id": {"type": "string", "minLength": 1},
    "fixture_status": {"enum": ["audit_draft", "source_reviewed"]},
    "provenance": {"type": ["string", "null"]},
    "source": {"type": "object"},
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entity"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "stocking": {
      "type": "object",
      "required": ["archetype_id", "seed"],
      "properties": {
        "archetype_id": {"type": "string", "minLength": 1},
        "seed": {"type": "string", "minLength": 1},
        "overrides": {"type": "object"}
      },
      "additionalProperties": true
    },
    "entity": {
      "type": "object",
      "required": ["entity_id", "name", "entity_type", "review_status"],
      "properties": {
        "entity_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "entity_type": {
          "enum": ["container", "seller", "local_vendor", "service", "hybrid", "event_market", "channel", "template", "reference", "unclassified"]
        },
        "parent_entity_id": {"type": "string"},
        "external_parent": {"type": "boolean"},
        "district": {"type": ["string", "null"]},
        "map_no": {"type": ["integer", "null"]},
        "book_page": {"type": ["integer", "null"]},
        "provenance": {"type": ["string", "null"]},
        "source_ref": {"type": ["string", "null"]},
        "source_summary": {"type": ["string", "null"]},
        "review_status": {"enum": ["audit_draft", "source_reviewed"]},
        "stock_policy": {"type": "string"},
        "commercial_mode": {"type": "string"},
        "stocking": {"$ref": "#/$defs/stocking"},
        "local_offerings": {"type": "array", "items": {"type": "object"}},
        "services": {"type": "array", "items": {"type": "object"}},
        "schedule": {"type": "object"},
        "audit": {"type": "object"}
      },
      "additionalProperties": true
    }
  }
}
