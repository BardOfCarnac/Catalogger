{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vend-r.invalid/schema/world-runtime-v0.3.schema.json",
  "title": "Vend-R world runtime graph v0.3",
  "type": "object",
  "required": ["format_version", "world_id", "fixture_id", "fixture_status", "entities", "relationships"],
  "properties": {
    "format_version": {"const": "0.3.0"},
    "source_format_version": {"type": "string"},
    "world_id": {"type": "string", "minLength": 1},
    "fixture_id": {"type": "string", "minLength": 1},
    "fixture_status": {"const": "source_reviewed"},
    "provenance": {"type": ["string", "null"]},
    "source": {"type": "object"},
    "entities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entity"}},
    "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}}
  },
  "additionalProperties": true,
  "$defs": {
    "supplyProfileRow": {
      "type": "object",
      "required": ["counterparty_label", "relationship"],
      "properties": {
        "counterparty_label": {"type": "string", "minLength": 1},
        "relationship": {"type": "string", "minLength": 1},
        "goods": {"type": "string"},
        "product_family": {"type": "string"}
      },
      "additionalProperties": true
    },
    "supplyProfile": {
      "type": "object",
      "required": ["outbound", "inbound"],
      "properties": {
        "outbound": {"type": "array", "items": {"$ref": "#/$defs/supplyProfileRow"}},
        "inbound": {"type": "array", "items": {"$ref": "#/$defs/supplyProfileRow"}}
      },
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "required": ["entity_id", "name", "entity_kind", "capabilities"],
      "properties": {
        "entity_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "entity_kind": {
          "enum": ["place", "outlet", "vendor", "service_point", "market_event", "channel", "chain", "template", "reference", "unclassified"]
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["catalog_stock", "local_wares", "services", "event", "distribution", "scheduled", "access_controlled", "purchase_policy"]}
        },
        "entity_type": {"type": "string"},
        "parent_entity_id": {"type": "string"},
        "district": {"type": ["string", "null"]},
        "map_no": {"type": ["integer", "null"]},
        "book_page": {"type": ["integer", "null"]},
        "provenance": {"type": ["string", "null"]},
        "source_ref": {"type": ["string", "null"]},
        "source_summary": {"type": ["string", "null"]},
        "stock_policy": {"type": "string"},
        "local_offerings": {"type": "array", "items": {"type": "object"}},
        "services": {"type": "array", "items": {"type": "object"}},
        "schedule": {"type": "object"},
        "supply_profile": {"$ref": "#/$defs/supplyProfile"},
        "shop": {"type": "object"},
        "assortment": {"type": "array"},
        "stock": {"type": "array"},
        "state": {"type": "object"}
      },
      "additionalProperties": true
    },
    "relationship": {
      "type": "object",
      "required": ["relationship_type", "source_entity_id", "target_entity_id"],
      "properties": {
        "relationship_type": {
          "enum": ["contained_in", "appears_at", "operated_by", "service_point_for", "chain_branch_of", "market_event_at", "supplies", "fulfills_for"]
        },
        "source_entity_id": {"type": "string", "minLength": 1},
        "target_entity_id": {"type": "string", "minLength": 1},
        "external_target": {"type": "boolean"},
        "inferred_from": {"type": "string"},
        "provenance": {"type": ["string", "null"]},
        "source_ref": {"type": ["string", "null"]},
        "note": {"type": "string"}
      },
      "additionalProperties": true
    }
  }
}
